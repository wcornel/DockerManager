<Window x:Class="DockerManager.App.Views.ProfileSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc ProfileSwitch_Title}" Height="295" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🔄 Profiel Wisselen" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="MessageTextBlock" Text="Er draaien momenteel actieve containers in het huidige profiel. Wat wil je doen?" 
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Explanation -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
            <TextBlock Text="{helpers:Loc ProfileSwitch_Tip}"
                       FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
        </Border>

        <!-- Checkbox: Niet meer vragen -->
        <CheckBox x:Name="DontAskAgainCheckBox"
                  Grid.Row="2"
                  Content="{helpers:Loc ProfileSwitch_DontAskAgain}"
                  FontSize="12" Foreground="#334155"
                  Margin="0,12,0,4" VerticalAlignment="Center" Cursor="Hand"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{helpers:Loc General_Cancel}" Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
            <Button Content="{helpers:Loc ProfileSwitch_StopAll}" Click="StopAll_Click" Padding="14,8" Margin="0,0,8,0"
                    Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="{helpers:Loc ProfileSwitch_KeepRunning}" Click="KeepRunning_Click" Padding="16,8"
                    Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
