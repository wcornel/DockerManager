<Window x:Class="DockerManager.App.Views.ProfileSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc ProfileSettings_Title}" Height="730" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{helpers:Loc ProfileSettings_Header}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{helpers:Loc ProfileSettings_Subheader}" 
                       FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- 1. Algemene Informatie -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc ProfileSettings_GeneralSection}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_NameLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_DescLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding AutoStopPreviousOnSwitch}" Margin="140,4,0,0">
                            <TextBlock Text="{helpers:Loc ProfileSettings_AutoStopLabel}" FontSize="12" Foreground="#475569"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 2. Snelle Overname ("Overnemen van...") -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{helpers:Loc ProfileSettings_CopySectionTitle}" FontSize="13" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                            <TextBlock Text="{helpers:Loc ProfileSettings_CopySectionTip}" FontSize="11.5" Foreground="#3B82F6" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_CopyFromLabel}" FontSize="12" Foreground="#1E40AF" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CopySources}" SelectedItem="{Binding SelectedCopySource, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Padding="8,5" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#93C5FD" FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{helpers:Loc ProfileSettings_CopyCloudflareBtn}" Command="{Binding CopyCloudflareSettingsCommand}"
                                    Padding="10,5" Margin="0,0,6,0" Background="#DBEAFE" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="Medium" FontSize="11.5"/>
                            <Button Content="{helpers:Loc ProfileSettings_CopyRegistryBtn}" Command="{Binding CopyRegistrySettingsCommand}"
                                    Padding="10,5" Margin="0,0,6,0" Background="#DBEAFE" Foreground="#1E40AF" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" FontWeight="Medium" FontSize="11.5"/>
                            <Button Content="{helpers:Loc ProfileSettings_CopyAllBtn}" Command="{Binding CopyAllSettingsCommand}"
                                    Padding="12,5" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11.5"/>
                        </StackPanel>

                        <TextBlock Text="{Binding CopyStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Cloudflare Tunnel & Domein -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{helpers:Loc ProfileSettings_CloudflareTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#EA580C" VerticalAlignment="Center"/>
                            <TextBlock Text="{helpers:Loc ProfileSettings_CloudflareTip}" FontSize="11.5" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Domein -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_DomainLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareDomain, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <!-- Account ID -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Account ID" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareAccountId, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <!-- Tunnel ID -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tunnel ID" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareTunnelId, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <!-- API Token -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API Token" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareApiToken, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <!-- Tunnel Token (cloudflared run) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_TunnelTokenLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareTunnelToken, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <!-- Test Cloudflare Button & Status -->
                        <DockPanel>
                            <Button Content="{helpers:Loc ProfileSettings_TestCloudflareBtn}" Command="{Binding TestCloudflareCommand}"
                                    IsEnabled="{Binding IsTestingCloudflare, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="12,5" Background="#FFF7ED" Foreground="#EA580C" BorderBrush="#FFEDD5" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding CloudflareTestStatus}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Container Registry / Repository -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{helpers:Loc ProfileSettings_RegistryTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                            <TextBlock Text="{helpers:Loc ProfileSettings_RegistryTip}" FontSize="11.5" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Server -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_RegistryServerLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RegistryServer, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <!-- Namespace / Organisatie -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_RegistryNamespaceLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RegistryNamespace, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <!-- Username -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_RegistryUserLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RegistryUsername, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="13"/>
                        </Grid>

                        <!-- Password / Token -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ProfileSettings_RegistryPassLabel}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RegistryPassword, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontSize="12" FontFamily="Consolas"/>
                        </Grid>

                        <!-- Test Registry Button & Status -->
                        <DockPanel>
                            <Button Content="{helpers:Loc ProfileSettings_TestRegistryBtn}" Command="{Binding TestRegistryCommand}"
                                    IsEnabled="{Binding IsTestingRegistry, Converter={StaticResource InverseBooleanConverter}}"
                                    Padding="12,5" Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#E0E7FF" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="12" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding RegistryTestStatus}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{helpers:Loc General_Cancel}" Command="{Binding CancelCommand}"
                    Padding="14,6" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
            <Button Content="{helpers:Loc General_Save}" Command="{Binding SaveCommand}"
                    Padding="18,6" Background="#4F46E5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
