<Window x:Class="DockerManager.App.Views.ImportComposeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc ImportCompose_Title}"
        Height="700" Width="840"
        MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="*"/>    <!-- 1: Body (File / YAML input & Options & Preview) -->
            <RowDefinition Height="Auto"/> <!-- 2: Status & Buttons -->
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{helpers:Loc ImportCompose_Header}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{helpers:Loc ImportCompose_Subheader}" 
                           FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 1: Body ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- Section 1: File selection & Direct YAML input -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc ImportCompose_Step1}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="{helpers:Loc ImportCompose_Browse}" Command="{Binding BrowseFileCommand}" 
                                    DockPanel.Dock="Right" Padding="12,5" Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"/>
                        </DockPanel>

                        <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" Padding="8,5" Margin="0,0,0,8"
                                 Visibility="{Binding FilePath, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                        <TextBlock Text="{helpers:Loc ImportCompose_PasteTip}" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding YamlText, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" AcceptsTab="True" Height="140" FontFamily="Consolas" FontSize="11.5"
                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button Content="{helpers:Loc ImportCompose_Analyze}" Command="{Binding ParseYamlCommand}" 
                                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="14,6" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Section 2: Bestemming (Toevoegen aan huidig profiel of Nieuw profiel) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc ImportCompose_Step2}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- Optie A: Toevoegen aan actief profiel -->
                        <RadioButton GroupName="ImportTarget" IsChecked="{Binding ImportIntoActiveProfile, Mode=TwoWay}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{helpers:Loc ImportCompose_TargetActive}" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding ActiveProfileName, StringFormat='\' {0} \''}" FontWeight="Bold" Foreground="#2563EB" FontSize="13"/>
                                <TextBlock Text="{helpers:Loc ImportCompose_Recommended}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Optie B: Nieuw profiel aanmaken -->
                        <RadioButton GroupName="ImportTarget" IsChecked="{Binding CreateNewProfile, Mode=TwoWay}" Margin="0,0,0,4">
                            <TextBlock Text="{helpers:Loc ImportCompose_TargetNew}" FontSize="13" Foreground="#0F172A"/>
                        </RadioButton>

                        <Grid Margin="24,4,0,0" IsEnabled="{Binding CreateNewProfile}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc ImportCompose_ProfileName}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Live Preview van Gevonden Containers -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{Binding HasParsedServices, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc ImportCompose_Step3}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding ParsedServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🐳 " FontSize="13"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ContainerName, StringFormat='({0})'}" Foreground="#64748B" FontSize="12"/>
                                                </StackPanel>
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock Text="Image: " FontSize="11.5" Foreground="#64748B" Width="60"/>
                                                    <TextBlock Text="{Binding Image}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,2" Visibility="{Binding Ports.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <TextBlock Text="{helpers:Loc Card_Ports, StringFormat='{}{0}: '}" FontSize="11.5" Foreground="#64748B" Width="60"/>
                                                    <TextBlock Text="{Binding Ports.Count, StringFormat='{}{0}'}" FontSize="11.5" Foreground="#0284C7"/>
                                                </DockPanel>
                                                <DockPanel Visibility="{Binding Volumes.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                    <TextBlock Text="{helpers:Loc Card_Volumes, StringFormat='{}{0}: '}" FontSize="11.5" Foreground="#64748B" Width="60"/>
                                                    <TextBlock Text="{Binding Volumes.Count, StringFormat='{}{0}'}" FontSize="11.5" Foreground="#D97706"/>
                                                </DockPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="#DCFCE7" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{helpers:Loc General_Ready}" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Footer Status & Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="#2563EB" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{helpers:Loc General_Cancel}" Command="{Binding CancelCommand}" Padding="16,8" Margin="0,0,8,0"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                <Button Content="{helpers:Loc ImportCompose_ImportBtn}" Command="{Binding ConfirmImportCommand}" Padding="20,8"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
