<Window x:Class="DockerManager.App.Views.AddProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc AddProfile_Title}" Height="390" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Inputs -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{helpers:Loc AddProfile_Header}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{helpers:Loc AddProfile_Subheader}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Inputs -->
        <StackPanel Grid.Row="1">
            <!-- Explainer Banner: Profile vs Container Network -->
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{helpers:Loc AddProfile_ExplainerTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#1D4ED8" Margin="0,0,0,2"/>
                    <TextBlock Text="{helpers:Loc AddProfile_ExplainerBody}"
                               FontSize="11.5" Foreground="#1E40AF" TextWrapping="Wrap" LineHeight="16"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{helpers:Loc AddProfile_NameLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="ProfileNameTextBox" 
                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontSize="13" Margin="0,0,0,10"/>

            <TextBlock Text="{helpers:Loc AddProfile_DescLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionTextBox" 
                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontSize="13"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{helpers:Loc General_Cancel}" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
            <Button Content="{helpers:Loc AddProfile_CreateBtn}" Click="Create_Click" Padding="16,6"
                    Background="#4F46E5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
