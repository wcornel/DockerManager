<Window x:Class="DockerManager.App.Views.PublishDotnetAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:services="clr-namespace:DockerManager.App.Services"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="760" Width="870"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Form ScrollViewer -->
            <RowDefinition Height="Auto"/> <!-- Status & Progress -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{helpers:Loc Dockerize_Subheader}" 
                           FontSize="12.5" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="{helpers:Loc Dockerize_PermissionsHelpBtn}" Command="{Binding ToggleHelpCommand}"
                    Padding="12,6" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                    FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center"
                    ToolTip="Uitleg over wie mag uploaden (schrijfrechten) en downloaden (leesrechten)"/>
        </Grid>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- Help & Permissions Explainer Banner (collapsible) -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                        Visibility="{Binding ShowPermissionsHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="💡 Belangrijk: Schrijfrechten (Pushen) vs. Leesrechten (Pullen)" FontWeight="Bold" Foreground="#1E40AF" FontSize="13" DockPanel.Dock="Left"/>
                            <Button Content="✕ Sluiten" Command="{Binding ToggleHelpCommand}" Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1E3A8A" LineHeight="19">
                            • <Bold>App Publiceren / Uploaden (Push):</Bold> Vereist een account met <Bold>schrijfrechten</Bold> (<Run FontFamily="Consolas">write:packages</Run> en <Run FontFamily="Consolas">repo</Run>). De ingevulde 'Account / Namespace' hieronder moet exact overeenkomen met het account waarmee je bent ingelogd (of een organisatie waarin je schrijfrechten hebt).&#x0a;
                            • <Bold>App Downloaden / Draaien (Pull door eindgebruikers):</Bold> Eindgebruikers hebben uitsluitend <Bold>leesrechten</Bold> nodig (<Run FontFamily="Consolas">read:packages</Run>). Als je de package in GitHub Container Registry op 'Public' zet, hebben zij zelfs helemaal géén inlog nodig!&#x0a;
                            • <Bold>Grote bestanden (&gt; 25 MB):</Bold> Als je app zware bibliotheken bevat (zoals Microsoft.Graph.dll), weigert de GitHub REST API uploads boven 25 MB. Klik in dat geval op <Bold>'💾 Dockerfile opslaan in projectmap'</Bold> en draai <Bold>'docker-build.bat'</Bold> om direct lokaal en zonder limiet te bouwen!
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Step 1: Select Folder Card -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc Dockerize_Step1Header}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Step1Description}" FontSize="12" Foreground="#64748B" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,8" FontSize="12.5"/>
                            <Button Grid.Column="1" Content="{helpers:Loc Dockerize_BrowseBtn}" Command="{Binding BrowseFolderCommand}"
                                    Padding="14,8" Margin="8,0,0,0" Background="#FFFFFF" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                                    FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 2: App Details & Configuration (Visible when IsScanned) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding IsScanned, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="{helpers:Loc Dockerize_Step2Header}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                            <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding Framework, StringFormat='Framework: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                        </DockPanel>

                        <!-- App Name, Port & Release Version Tag -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc Dockerize_AppNameLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{helpers:Loc Dockerize_PortLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ContainerPort, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{helpers:Loc Dockerize_ReleaseTagLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding VersionTag, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Python Start Command (if Python) -->
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding IsPython, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{helpers:Loc Dockerize_PythonCmdLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding StartCommand, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- Target Registry & Image Name Preview -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc Wizard_TargetRegistry}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableRegistries}" SelectedItem="{Binding SelectedTargetRegistry, Mode=TwoWay}"
                                          Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{helpers:Loc Dockerize_NamespaceLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TargetGitHubOwner, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"
                                         ToolTip="Belangrijk: Dit moet het account zijn waarmee je bent ingelogd en waar je schrijfrechten (push) op hebt. Eindgebruikers die later deze container downloaden hebben alleen leesrechten (pull) nodig."/>
                            </StackPanel>
                        </Grid>

                        <!-- Live Result Badge with Dual Tags -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{helpers:Loc Dockerize_ReleaseTagPreview}" FontSize="12" Foreground="#166534" FontWeight="Bold" Width="145"/>
                                    <TextBlock Text="{Binding LiveReleaseImageTag}" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" FontFamily="Consolas"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="{helpers:Loc Dockerize_RollingTagPreview}" FontSize="12" Foreground="#166534" FontWeight="Bold" Width="145"/>
                                    <TextBlock Text="{Binding LiveTargetImageName}" FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" FontFamily="Consolas"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Base Image -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc Dockerize_BaseImageLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BaseDockerImage, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsDotnet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{helpers:Loc Dockerize_EntrypointLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EntrypointDll, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Step 3: Parameter Checklist (Visible when IsScanned) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding IsScanned, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{helpers:Loc Dockerize_Step3Header}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{helpers:Loc Dockerize_Step3Subheader}" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="{helpers:Loc Dockerize_ToggleAll}" Command="{Binding ToggleSelectAllCommand}" 
                                        Padding="8,4" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                                <Button Content="{helpers:Loc Dockerize_ViewDockerfile}" Command="{Binding ToggleDockerfilePreviewCommand}" 
                                        Padding="8,4" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Parameters List -->
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:ScannedConfigParam}">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="1" Background="#E2E8F0" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>

                                            <!-- Parameter Key & Docker ENV Name -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Key}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DockerEnvKey, StringFormat='Docker ENV: {0}'}" FontSize="10.5" Foreground="#0284C7" FontFamily="Consolas"/>
                                            </StackPanel>

                                            <!-- Current Value -->
                                            <TextBlock Grid.Column="3" Text="{Binding CurrentValue}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Dockerfile Preview Box (Expandable) -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding ShowDockerfilePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox Text="{Binding GeneratedDockerfile}" IsReadOnly="True" Background="Transparent" Foreground="#F8FAFC"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="11.5" AcceptsReturn="True" TextWrapping="NoWrap"/>
                        </Border>

                        <!-- Production Hardening Checkboxes -->
                        <StackPanel Margin="0,14,0,0">
                            <CheckBox IsChecked="{Binding EnableAmsterdamTimezone}" Margin="0,0,0,8" Foreground="#0F172A">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{helpers:Loc Dockerize_TzAms}" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding EnablePersistentVolume}" Margin="0,0,0,8" Foreground="#0F172A">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{helpers:Loc Dockerize_Volume}" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- Push to Registry Checkbox -->
                            <CheckBox IsChecked="{Binding PushToRegistry}" Margin="0,0,0,8" Foreground="#0F172A">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{helpers:Loc Dockerize_PushRegistry}" FontWeight="Bold" Foreground="#0284C7"/>
                                </StackPanel>
                            </CheckBox>

                            <!-- Auto-add to DockerManager Profile Checkbox -->
                            <CheckBox IsChecked="{Binding AddToActiveProfile}" Margin="0,0,0,0" Foreground="#0F172A">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{helpers:Loc Dockerize_AddToProfile}" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <!-- Cloudflare Tunnel Integration -->
                        <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding HasCloudflareConfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding EnableCloudflareTunnel}" Foreground="#0F172A">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{helpers:Loc Dockerize_CloudflareEnable}" FontWeight="Bold" Foreground="#EA580C"/>
                                    </StackPanel>
                                </CheckBox>
                                
                                <Grid Margin="24,8,0,0" IsEnabled="{Binding EnableCloudflareTunnel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="https://" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBox Grid.Column="1" Text="{Binding CloudflareSubdomain, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" Margin="4,0,4,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CloudflareDomain, StringFormat='. {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                                </Grid>

                                <TextBlock Margin="24,4,0,0" FontSize="11" Foreground="#9A3412" TextWrapping="Wrap"
                                           Text="{helpers:Loc Dockerize_CloudflareSubdomainTip}"/>

                                <TextBlock Margin="24,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"
                                           Text="{Binding CloudflareStatusMessage}"
                                           Visibility="{Binding CloudflareStatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status & Success Info -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,12">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Image Tag: " FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding ImageTag}" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,12,0"/>
                    <Button Content="{helpers:Loc Dockerize_ViewOnGitHub}" Command="{Binding OpenGitHubUrlCommand}"
                            Padding="8,2" Background="#F1F5F9" Foreground="#4F46E5" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                    <Button Content="{Binding FullCloudflareUrl, StringFormat='🔗 Open {0}'}" Command="{Binding OpenCloudflareUrlCommand}"
                            Visibility="{Binding FullCloudflareUrl, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"
                            Margin="8,0,0,0" Padding="8,2" Background="#FFF7ED" Foreground="#EA580C" BorderBrush="#FDBA74" BorderThickness="1" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3">
            <Button Content="{helpers:Loc General_Close}" Command="{Binding CloseCommand}" Padding="16,8" DockPanel.Dock="Left"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"
                        Visibility="{Binding IsScanned, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="{helpers:Loc Dockerize_SaveDockerfileBtn}" Command="{Binding SaveDockerfileToProjectFolderCommand}"
                        Padding="16,8" Margin="0,0,10,0" Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#BAE6FD" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"
                        ToolTip="Genereert direct een Dockerfile, .dockerignore en docker-build.bat in de gekozen projectmap"/>
                <Button Content="{helpers:Loc Dockerize_BuildAndAddBtn}" Command="{Binding PublishCommand}"
                        Padding="20,8" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        ToolTip="Bouwt de Docker container lokaal via Docker en voegt hem direct toe aan je actieve profiel (en pusht optioneel direct naar de registry)"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
