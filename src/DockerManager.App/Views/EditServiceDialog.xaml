<Window x:Class="DockerManager.App.Views.EditServiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc EditService_Title}" Height="720" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{helpers:Loc EditService_Header}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{helpers:Loc EditService_Subheader}" 
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            <TextBlock Text="{helpers:Loc EditService_NetworkTip}" 
                       FontSize="11.5" Foreground="#0284C7" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Content (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Section 1: Basis Informatie -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc EditService_General}" FontSize="14" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc EditService_DisplayName}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{helpers:Loc EditService_ContainerName}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ContainerName, UpdateSourceTrigger=PropertyChanged}" 
                                         PreviewKeyDown="ContainerNameTextBox_PreviewKeyDown"
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc EditService_ImageLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                                <Button Grid.Column="1" Command="{Binding InspectAndDownloadImageCommand}" 
                                        Padding="12,6" Margin="8,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"
                                        ToolTip="{helpers:Loc EditService_InspectToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" Margin="0,0,6,0"/>
                                        <TextBlock Text="{helpers:Loc EditService_DownloadInspect}" FontWeight="SemiBold" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Inspect Status Feedback Message -->
                            <TextBlock Text="{Binding InspectStatusMessage}" FontSize="11.5" Foreground="#0284C7" FontWeight="Medium" 
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding InspectStatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Private / Authentication Checkbox -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <CheckBox IsChecked="{Binding RequiresAuth}" Foreground="#0F172A">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{helpers:Loc EditService_PrivatePackage}" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,6,0"/>
                                    <TextBlock Text="{helpers:Loc EditService_PrivatePackageTip}" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc EditService_Description}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc EditService_WorkingDir}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WorkingDir, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"
                                         ToolTip="{helpers:Loc EditService_WorkingDirTip}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{helpers:Loc EditService_StartCommand}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"
                                         ToolTip="{helpers:Loc EditService_StartCommandTip}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{helpers:Loc EditService_RestartPolicy}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableRestartPolicies}" SelectedItem="{Binding RestartPolicy}"
                                          Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,18,0,0">
                                <CheckBox Content="{helpers:Loc EditService_AutoStart}" IsChecked="{Binding AutoStart}" Foreground="#0F172A"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Poort Mappings -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc EditService_PortsHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="{helpers:Loc EditService_AddPort}" Command="{Binding AddPortCommand}" Padding="8,4" Background="#16A34A" Foreground="White" BorderThickness="0" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding HostPortDisplay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Host Poort (bijv. 8009 of 0.0.0.0:8009 of 127.0.0.1:8009)"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <TextBlock Grid.Column="1" Text=" → " Foreground="#64748B" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding ContainerPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Container Poort"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <TextBox Grid.Column="3" Text="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}" ToolTip="Protocol (tcp/udp)" Margin="6,0,0,0"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <Button Grid.Column="4" Content="✕" 
                                                Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="6,0,0,0" Padding="8,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 3: Volumes -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc EditService_VolumesHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#D97706" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="{helpers:Loc EditService_AddVolume}" Command="{Binding AddVolumeCommand}" Padding="8,4" Background="#D97706" Foreground="White" BorderThickness="0" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Volumes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding HostPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Host pad of Named Volume"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <TextBlock Grid.Column="1" Text=" : " Foreground="#64748B" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding ContainerPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pad binnen de container (bijv. /app/data)"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <Button Grid.Column="3" Content="✕" 
                                                Command="{Binding DataContext.RemoveVolumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="6,0,0,0" Padding="8,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 4: Omgevingsvariabelen (.env) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{helpers:Loc EditService_EnvHeader}" FontSize="14" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="{helpers:Loc EditService_AddEnv}" Command="{Binding AddEnvVarCommand}" Padding="8,4" Background="#7C3AED" Foreground="White" BorderThickness="0" FontSize="11" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Informational notice: Environment variable changes take effect on restart -->
                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                            <TextBlock Text="{helpers:Loc EditService_EnvRestartTip}" FontSize="11.5" Foreground="#6D28D9" TextWrapping="Wrap"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" ToolTip="Key (bijv. DB_HOST)"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <TextBlock Grid.Column="1" Text=" = " Foreground="#64748B" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="Value"
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                        <Button Grid.Column="3" Content="✕" 
                                                Command="{Binding DataContext.RemoveEnvVarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="6,0,0,0" Padding="8,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 5: Cloudflare Tunnel Koppeling -->
                <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0"
                        Visibility="{Binding HasCloudflareConfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding EnableCloudflareTunnel}" Foreground="#0F172A">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{helpers:Loc EditService_CloudflareHeader}" FontWeight="Bold" Foreground="#EA580C" FontSize="13.5"/>
                            </StackPanel>
                        </CheckBox>

                        <Grid Margin="24,10,0,0" IsEnabled="{Binding EnableCloudflareTunnel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <!-- Subdomain input -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="https://" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CloudflareSubdomain, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" Margin="4,0,4,0" ToolTip="Subdomein (bijv. api of app)"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CloudflareDomain, StringFormat='. {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>

                            <!-- Target Host Port -->
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{helpers:Loc EditService_CloudflarePort}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding SelectedCloudflarePort, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" Margin="6,0,0,0" ToolTip="Hostpoort van de container (bijv. 8002)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,6,0,0" FontSize="11" Foreground="#9A3412" TextWrapping="Wrap"
                                       Text="{helpers:Loc EditService_CloudflareTip}"/>
                        </Grid>

                        <TextBlock Margin="24,6,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"
                                   Text="{Binding CloudflareStatusMessage}"
                                   Visibility="{Binding CloudflareStatusMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{helpers:Loc General_Cancel}" Command="{Binding CancelCommand}" Padding="16,8"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{helpers:Loc General_Save}" Command="{Binding SaveCommand}" Padding="20,8"
                        Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
