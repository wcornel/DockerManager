<Window x:Class="DockerManager.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc Settings_Title}" Height="700" Width="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{helpers:Loc Menu_Settings}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="{helpers:Loc Settings_Subheader}" 
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Body (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Section 1: Docker Servers & Omgevingen -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{helpers:Loc Settings_DockerServers}" FontSize="15" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="{helpers:Loc Settings_AddServerBtn}" Command="{Binding AddServerCommand}" 
                                        Padding="10,4" Margin="0,0,6,0" Background="#F0FDF4" Foreground="#16A34A" BorderBrush="#BBF7D0" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="{helpers:Loc Settings_DeleteServerBtn}" Command="{Binding DeleteServerCommand}" 
                                        Padding="10,4" Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{helpers:Loc Settings_ServersDescription}"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Server Kiezer -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:Loc Settings_SelectServer}" FontSize="12" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding EditingServer, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Padding="8,6" Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,4"
                                Visibility="{Binding EditingServer, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <!-- Server Name & Subfolder Grid -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{helpers:Loc Settings_ServerNameLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingServer.Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                                    </StackPanel>

                                    <!-- Subfolder -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{helpers:Loc Settings_ServerSubfolderLabel}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditingServer.ProfilesSubfolder, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{helpers:Loc Settings_ServerSubfolderTip}" FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                <!-- Host Type Radios -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="{helpers:Loc Settings_HostLocal}" IsChecked="{Binding IsPipeSelected}" 
                                                 Command="{Binding SelectPipeCommand}" Foreground="#0F172A" Margin="0,0,24,0"/>
                                    <RadioButton Content="{helpers:Loc Settings_HostTcp}" IsChecked="{Binding IsTcpSelected}" 
                                                 Command="{Binding SelectTcpCommand}" Foreground="#0F172A"/>
                                </StackPanel>

                                <!-- Named Pipe input -->
                                <StackPanel Visibility="{Binding IsPipeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                    <TextBlock Text="{helpers:Loc Settings_PipeName}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingServer.PipeName, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                                </StackPanel>

                                <!-- TCP Endpoint input -->
                                <StackPanel Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                    <TextBlock Text="{helpers:Loc Settings_TcpUrl}" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingServer.TcpUrl, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6"/>
                                </StackPanel>

                                <!-- Test Docker Button -->
                                <DockPanel Margin="0,4,0,0">
                                    <Button Content="{helpers:Loc Settings_TestDocker}" Command="{Binding TestDockerConnectionCommand}" 
                                             Padding="14,6" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding DockerTestStatus}" Foreground="#0284C7" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 2: Container Registries (ghcr.io, Azure ACR, GitLab, Docker Hub, etc.) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{helpers:Loc Settings_Registries}" FontSize="15" FontWeight="SemiBold" Foreground="#0284C7" DockPanel.Dock="Left"/>
                            <TextBlock Text="{helpers:Loc Settings_RegistriesDpapi}" FontSize="11" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{helpers:Loc Settings_RegistriesDesc}" 
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Lijst van registries -->
                        <ItemsControl ItemsSource="{Binding Registries}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                        <DockPanel LastChildFill="True">
                                            <!-- Knoppen Rechts -->
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <!-- GitHub Inloggen / Instellingen Knop (voor ghcr.io) -->
                                                <Button Command="{Binding DataContext.ConfigureRegistryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsGitHubRegistry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Padding="10,4" Margin="0,0,6,0" Cursor="Hand" BorderThickness="1">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#EEF2FF"/>
                                                            <Setter Property="Foreground" Value="#4F46E5"/>
                                                            <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                                            <Setter Property="Content" Value="⚙️ Instellingen"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                                                    <Setter Property="Background" Value="#4F46E5"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Content" Value="🔑 Inloggen via GitHub"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Test Knopje -->
                                                <Button Content="🔍 Test" Command="{Binding DataContext.TestRegistryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0" Background="#F0FDF4" Foreground="#16A34A" BorderBrush="#BBF7D0" BorderThickness="1" Cursor="Hand" ToolTip="Test verbinding en authenticatie"/>

                                                <!-- Verwijderen of Uitloggen -->
                                                <Button Content="🗑️" Command="{Binding DataContext.DeleteRegistryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Padding="8,4" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0" Cursor="Hand" ToolTip="Registry verwijderen of uitloggen"
                                                        Visibility="{Binding IsConfigured, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Registry Info Links -->
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🌐 " FontSize="12"/>
                                                    <TextBlock Text="{Binding ServerAddress}" FontWeight="Bold" Foreground="#0F172A" FontSize="13" Margin="0,0,8,0"/>

                                                    <!-- Ingelogd / Geconfigureerd Badge -->
                                                    <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Visibility="{Binding IsConfigured, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Username, StringFormat='👤 {0}'}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Niet gekoppeld Badge (bijv. ghcr.io) -->
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Visibility="{Binding IsConfigured, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Niet gekoppeld (optioneel)" Foreground="#64748B" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#64748B" FontSize="11" Margin="18,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Registry Test Status Feedback -->
                        <TextBlock Text="{Binding RegistryTestStatus}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,0,0,8"
                                   Visibility="{Binding RegistryTestStatus, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                        <!-- Nieuwe Registry Toevoegen -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{helpers:Loc Settings_AddExtraRegistry}" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewRegistryServer, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" ToolTip="Server URL (bijv. mijn.azurecr.io, registry.gitlab.com, docker.io)"/>
                                    <TextBox Grid.Column="2" Text="{Binding NewRegistryUsername, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" ToolTip="Gebruikersnaam of Client ID"/>
                                    <TextBox Grid.Column="4" Text="{Binding NewRegistryPassword, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" ToolTip="Token, Wachtwoord of Client Secret"/>
                                    <Button Grid.Column="6" Content="{helpers:Loc Settings_AddBtn}" Command="{Binding AddCustomRegistryCommand}" 
                                            Padding="10,4" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{helpers:Loc Settings_AddRegistryHelp}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section 3: Cloudflare Tunnel Integratie (Optioneel voor publieke HTTPS toegang) -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{helpers:Loc Settings_CloudflareHeader}" FontSize="15" FontWeight="SemiBold" Foreground="#EA580C" DockPanel.Dock="Left"/>
                            <TextBlock Text="{helpers:Loc Settings_RegistriesDpapi}" FontSize="11" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{helpers:Loc Settings_CloudflareDesc}" 
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Cloudflare API Token -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cloudflare API Token:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareApiToken, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" ToolTip="API Token met rechten: Zone.DNS:Edit en Account.Cloudflare Tunnel:Edit"/>
                        </Grid>

                        <!-- Account ID -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Account ID:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareAccountId, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" ToolTip="Cloudflare Account ID (te vinden in de browser URL of dashboard)"/>
                            <Button Grid.Column="2" Content="{helpers:Loc Settings_FetchTunnels}" Command="{Binding LoadCloudflareTunnelsCommand}"
                                    Margin="8,0,0,0" Padding="12,5" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Haalt automatisch alle bestaande tunnels op uit je Cloudflare account"/>
                        </Grid>

                        <!-- Tunnel Selectie & Beheer -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{helpers:Loc Settings_ActiveTunnel}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTunnels}" SelectedItem="{Binding SelectedTunnel}"
                                      DisplayMemberPath="DisplayName" Padding="8,6" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1"
                                      ToolTip="Selecteer een tunnel uit je Cloudflare account"/>
                            <Button Grid.Column="2" Content="{helpers:Loc Settings_NewTunnel}" Command="{Binding ToggleCreateTunnelBoxCommand}"
                                    Margin="8,0,0,0" Padding="10,5" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Maak direct een nieuwe, geïsoleerde tunnel aan via de Cloudflare API"/>
                            <Button Grid.Column="3" Content="🗑️" Command="{Binding DeleteTunnelCommand}"
                                    Margin="6,0,0,0" Padding="10,5" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FCA5A5" BorderThickness="1" FontWeight="Bold" Cursor="Hand"
                                    ToolTip="Verwijder de geselecteerde tunnel uit Cloudflare"/>
                        </Grid>

                        <!-- Create Tunnel Form Box -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding ShowCreateTunnelBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{helpers:Loc Settings_CreateTunnelHeader}" FontWeight="Bold" FontSize="11.5" Foreground="#166534" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewTunnelName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="{helpers:Loc Settings_CreateInCloudflare}" Command="{Binding CreateTunnelConfirmCommand}"
                                            Margin="6,0,0,0" Padding="10,4" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="{helpers:Loc General_Cancel}" Command="{Binding ToggleCreateTunnelBoxCommand}"
                                            Margin="6,0,0,0" Padding="8,4" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Manual Tunnel ID fallback -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tunnel ID (UUID):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#64748B" FontSize="11.5"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareTunnelId, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" Padding="8,4" FontSize="11.5" FontFamily="Consolas"/>
                        </Grid>

                        <!-- Domeinnaam -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{helpers:Loc Settings_MainDomain}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding CloudflareDomain, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,5" ToolTip="Bijv. jouwbedrijf.nl (waarop subdomeinen worden aangemaakt)"/>
                        </Grid>

                        <!-- Test Button & Status -->
                        <DockPanel>
                            <Button Content="{helpers:Loc Settings_TestCloudflare}" Command="{Binding TestCloudflareConnectionCommand}"
                                    Padding="14,6" Background="#EA580C" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding CloudflareTestStatus}" Foreground="#0284C7" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Section 4: Voorkeuren -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc Settings_AppPreferences}" FontSize="15" FontWeight="SemiBold" Foreground="#059669" Margin="0,0,0,12"/>

                        <!-- Taal / Language Keuze -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{helpers:Loc Settings_Language}" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                <TextBlock Text="Nederlands (NL) / English (EN)" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguageDisplay, Mode=TwoWay}"
                                      Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8,6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,12"/>

                        <CheckBox Content="{helpers:Loc Settings_AutoCheckProfiles}" IsChecked="{Binding AutoCheckUpdatesOnStart}" 
                                  Foreground="#0F172A" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="{helpers:Loc Settings_AutoCheckImages}" 
                                      IsChecked="{Binding AutoCheckImageUpdates}" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableFrequencies}" SelectedItem="{Binding UpdateCheckFrequency}"
                                      IsEnabled="{Binding AutoCheckImageUpdates}"
                                      Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4"/>
                        </Grid>

                        <CheckBox Content="{helpers:Loc Settings_KeepRunningOnSwitch}" IsChecked="{Binding DefaultKeepRunningOnSwitch}" 
                                  Foreground="#0F172A" Margin="0,0,0,10"/>

                        <CheckBox Content="{helpers:Loc Settings_ConfirmOnSwitch}" IsChecked="{Binding PromptToStopPreviousProfile}" 
                                  Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="{helpers:Loc General_Cancel}" Command="{Binding CancelCommand}" Padding="16,8"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" DockPanel.Dock="Left"/>
            <Button Content="{helpers:Loc Settings_SaveAndClose}" Click="SaveButton_Click" Padding="20,8"
                    Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
