<Window x:Class="DockerManager.App.Views.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{helpers:Loc LogViewer_Header}" FontSize="18" FontWeight="SemiBold" Foreground="#0F172A"/>
                <Ellipse Width="10" Height="10" Margin="12,0,6,0"
                         Fill="{Binding IsStreaming, Converter={StaticResource BooleanToBrushConverter}, FallbackValue='#16A34A'}"/>
                <TextBlock Text="{Binding IsStreaming, StringFormat='Streaming: {0}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{helpers:Loc LogViewer_Copy}" Click="CopyButton_Click" Margin="0,0,8,0" Padding="12,6"
                        Background="#FFFFFF" Foreground="#1E293B" BorderBrush="#CBD5E1" Cursor="Hand"/>
                <Button Content="{helpers:Loc LogViewer_Clear}" Click="ClearButton_Click" Margin="0,0,8,0" Padding="12,6"
                        Background="#FFFFFF" Foreground="#1E293B" BorderBrush="#CBD5E1" Cursor="Hand"/>
                <Button Content="{helpers:Loc LogViewer_Stop}" Command="{Binding StopStreamingCommand}" Padding="12,6"
                        Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Log Content Box (High performance TextBox in dark terminal frame) -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
            <TextBox x:Name="LogTextBox" 
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" 
                     BorderThickness="0" 
                     Foreground="#F8FAFC"
                     FontFamily="Consolas, Cascadia Code, Courier New" 
                     FontSize="13"/>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox x:Name="AutoScrollCheckBox" Content="{helpers:Loc LogViewer_AutoScroll}" IsChecked="True" 
                      Foreground="#475569" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="{helpers:Loc General_Close}" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
