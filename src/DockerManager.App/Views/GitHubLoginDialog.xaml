<Window x:Class="DockerManager.App.Views.GitHubLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DockerManager.App.ViewModels"
        xmlns:helpers="clr-namespace:DockerManager.App.Helpers"
        mc:Ignorable="d"
        Title="{helpers:Loc GitHubLogin_Title}" Height="480" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/DockerManager.App;component/app.ico"
        Background="#F8FAFC" Foreground="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐙" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{helpers:Loc GitHubLogin_Title}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{helpers:Loc GitHubLogin_Subheader}" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Main Body -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel VerticalAlignment="Center">

                <!-- Step 1 Button -->
                <TextBlock Text="{helpers:Loc GitHubLogin_Step1}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                <Button Content="{helpers:Loc GitHubLogin_GenerateBtn}" Command="{Binding OpenGitHubGenerateTokenPageCommand}"
                        Padding="16,10" Background="#4F46E5" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                <!-- Step 2 Input -->
                <TextBlock Text="{helpers:Loc GitHubLogin_Step2}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}" 
                             Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="10,8"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"/>
                    <Button Grid.Column="1" Content="{helpers:Loc GitHubLogin_PasteBtn}" Command="{Binding PasteFromClipboardCommand}"
                            Padding="12,8" Margin="8,0,0,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                </Grid>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#0284C7" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Step 3 Validate Button -->
                <Button Content="{helpers:Loc GitHubLogin_VerifyBtn}" Command="{Binding ValidateAndSaveTokenCommand}"
                        Padding="18,10" Background="#16A34A" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Stretch"/>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{helpers:Loc GitHubLogin_DpapiTip}" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="{helpers:Loc General_Cancel}" Command="{Binding CancelCommand}" Padding="16,8"
                    Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
